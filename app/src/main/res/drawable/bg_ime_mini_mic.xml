<?xml version="1.0" encoding="utf-8"?>
<!-- Circular surface for the secondary (AI cleanup) mic on the voice keyboard.
     Solid white so RustInputMethodService can recolor it via backgroundTint, the
     same way it tints the main record circle. Touch feedback comes from a
     borderless ripple foreground set in the layout — a RippleDrawable here would
     be tinted along with the fill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/white" />
</shape>

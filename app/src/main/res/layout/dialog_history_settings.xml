<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/history_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/history_setting_enabled" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/history_audio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/history_setting_audio" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/history_setting_audio_days"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <RadioGroup
        android:id="@+id/history_audio_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/history_days_forever"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_days_forever" />

        <RadioButton
            android:id="@+id/history_days_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_days_1" />

        <RadioButton
            android:id="@+id/history_days_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_days_7" />

        <RadioButton
            android:id="@+id/history_days_30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_days_30" />
    </RadioGroup>

    <TextView
        android:id="@+id/history_storage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
